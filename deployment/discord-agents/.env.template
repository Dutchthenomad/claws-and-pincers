# Discord Multi-Agent Environment Variables
# Copy this file to .env and fill in your actual tokens
# DO NOT commit .env to git - it contains secrets!

# ═══════════════════════════════════════════════════════════════════
# DISCORD BOT TOKENS - Required for each agent
# Get these from Discord Developer Portal: https://discord.com/developers/applications
# ═══════════════════════════════════════════════════════════════════

DISCORD_ORCHESTRATOR_TOKEN=your_orchestrator_token_here
DISCORD_RESEARCHER_TOKEN=your_researcher_token_here
DISCORD_DEVELOPER_TOKEN=your_developer_token_here
DISCORD_SYSADMIN_TOKEN=your_sysadmin_token_here
DISCORD_REVIEWER_TOKEN=your_reviewer_token_here

# ═══════════════════════════════════════════════════════════════════
# ADVANCED SETTINGS
# ═══════════════════════════════════════════════════════════════════

# Log level: debug, info, warn, error
LOG_LEVEL=info

# Model routing fallbacks
FALLBACK_MODELS=openai/gpt-5.2,openrouter/moonshotai/kimi-k2.5

# Cost tracking
COST_TRACKING_ENABLED=true
COST_DAILY_BUDGET=10.00

# Feature flags
ENABLE_WEB_SEARCH=true
ENABLE_BROWSER=true
ENABLE_DISCORD=true
