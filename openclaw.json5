// ~/.openclaw/openclaw.json5
// Claws & Pincers — Production Multi-Agent Configuration
// Updated: 2026-03-01 — Native OpenClaw alignment (hub-and-spoke, heartbeats, tool policy, native features)
//
// ENVIRONMENT VARIABLES REQUIRED (set in /opt/openclaw/config/.env):
//   OPENROUTER_API_KEY
//   DISCORD_ORCHESTRATOR_TOKEN, DISCORD_RESEARCHER_TOKEN
//   DISCORD_DEVELOPER_TOKEN, DISCORD_SYSADMIN_TOKEN, DISCORD_REVIEWER_TOKEN
//   OPENCLAW_GATEWAY_TOKEN, GATEWAY_AUTH_TOKEN

{
  env: {
    vars: {
      OPENROUTER_API_KEY: "${OPENROUTER_API_KEY}",
    },
  },

  logging: {
    level: "info",
    file: "/home/node/.openclaw/logs/openclaw.log",
    consoleLevel: "info",
    consoleStyle: "pretty",
    redactSensitive: "tools",
  },

  agents: {
    defaults: {
      model: {
        primary: "openrouter/moonshotai/kimi-k2.5",
        fallbacks: ["openrouter/google/gemini-3-flash-preview"],
      },
      models: {
        "openrouter/anthropic/claude-opus-4.6": { alias: "opus" },
        "openrouter/minimax/minimax-m2.5": { alias: "minimax" },
        "openrouter/x-ai/grok-4.1-fast": { alias: "grok" },
        "openrouter/moonshotai/kimi-k2.5": { alias: "kimi" },
        "openrouter/google/gemini-3-flash-preview": { alias: "gemini" },
        "anthropic/claude-sonnet-4-5": { alias: "sonnet", params: { cacheControlTtl: "1h" } },
        // groq models removed — all routing through OpenRouter only
      },
      workspace: "/home/agent-main",
      userTimezone: "America/New_York",
      contextPruning: { mode: "cache-ttl", ttl: "1h" },
      compaction: { mode: "safeguard" },
      thinkingDefault: "adaptive",
      timeoutSeconds: 600,
      // NOTE: Per-agent heartbeats defined below. When any agent has a heartbeat block,
      // only those agents run heartbeats (per OpenClaw docs).
      maxConcurrent: 2,
      subagents: { maxConcurrent: 8 },
      sandbox: { mode: "off" },

      // Memory search with vector embeddings via OpenRouter (OpenAI-compatible)
      memorySearch: {
        enabled: true,
        provider: "openai",
        model: "openai/text-embedding-3-small",
        remote: {
          baseUrl: "https://openrouter.ai/api/v1/",
          apiKey: "${OPENROUTER_API_KEY}",
        },
        fallback: "none",
        store: {
          driver: "sqlite",
          vector: {
            enabled: true,
            extensionPath: "/app/node_modules/.pnpm/sqlite-vec-linux-x64@0.1.7-alpha.2/node_modules/sqlite-vec-linux-x64/vec0.so",
          },
        },
        chunking: { tokens: 512, overlap: 64 },
        query: {
          maxResults: 10,
          minScore: 0.3,
          hybrid: { enabled: true, vectorWeight: 0.7, textWeight: 0.3 },
        },
        sync: { onSessionStart: true, onSearch: false, watch: true },
        cache: { enabled: true, maxEntries: 50000 },
      },
    },

    list: [
      // === ORCHESTRATOR — Hub of hub-and-spoke. Coordinator only. ===
      {
        id: "orchestrator",
        default: true,
        workspace: "~/.openclaw/workspace-orchestrator",
        agentDir: "~/.openclaw/agents/orchestrator/agent",
        model: { primary: "openrouter/anthropic/claude-opus-4.6", fallbacks: ["openrouter/moonshotai/kimi-k2.5"] },
        identity: { name: "Orchestrator", emoji: "🎯" },
        groupChat: { mentionPatterns: ["@orchestrator", "@orch", "@Orchestrator"] },
        subagents: { allowAgents: ["*"] },
        sandbox: { mode: "off" },
        heartbeat: { every: "15m" },
        tools: {
          profile: "full",
          // Orchestrator: coordinator only — no exec (C-09). Full session + automation tools.
          allow: ["read", "write", "edit", "sessions_list", "sessions_history", "sessions_send", "sessions_spawn", "session_status", "subagents", "agents_list", "message", "web_search", "web_fetch", "browser", "cron", "gateway", "memory_search", "memory_get"],
          deny: ["exec", "apply_patch"],
          agentToAgent: { enabled: true, allow: ["*"] },
        },
      },

      // === RESEARCHER — Knowledge engine. Read-only research, no exec. ===
      {
        id: "researcher",
        workspace: "~/.openclaw/workspace-researcher",
        agentDir: "~/.openclaw/agents/researcher/agent",
        model: { primary: "openrouter/x-ai/grok-4.1-fast", fallbacks: ["openrouter/moonshotai/kimi-k2.5"] },
        identity: { name: "Researcher", emoji: "🔬" },
        groupChat: { mentionPatterns: ["@researcher", "@research", "@Researcher"] },
        sandbox: { mode: "off" },
        heartbeat: { every: "2h", model: "openrouter/google/gemini-3-flash-preview" },
        tools: {
          // Researcher: no exec (C-09), no sessions_spawn (only Orchestrator spawns).
          allow: ["read", "write", "sessions_list", "sessions_history", "sessions_send", "web_search", "web_fetch", "browser", "message", "memory_search", "memory_get"],
          deny: ["exec", "edit", "apply_patch", "cron", "gateway", "nodes", "canvas", "sessions_spawn"],
          agentToAgent: { enabled: true, allow: ["orchestrator"] },
        },
      },

      // === DEVELOPER — Builder. Code execution with lenient sandbox. ===
      {
        id: "developer",
        workspace: "~/.openclaw/workspace-developer",
        agentDir: "~/.openclaw/agents/developer/agent",
        model: { primary: "openrouter/minimax/minimax-m2.5", fallbacks: ["openrouter/moonshotai/kimi-k2.5"] },
        identity: { name: "Developer", emoji: "💻" },
        groupChat: { mentionPatterns: ["@developer", "@dev", "@Developer"] },
        sandbox: { mode: "lenient" },
        heartbeat: { every: "2h", model: "openrouter/google/gemini-3-flash-preview" },
        tools: {
          // Developer: exec allowed (needs to run code), web_search added (C-09). No sessions_spawn.
          allow: ["exec", "read", "write", "edit", "apply_patch", "sessions_list", "sessions_history", "sessions_send", "web_search", "web_fetch", "message", "memory_search", "memory_get"],
          deny: ["browser", "cron", "gateway", "nodes", "canvas", "sessions_spawn"],
          agentToAgent: { enabled: true, allow: ["orchestrator"] },
        },
      },

      // === SYSADMIN — Infrastructure guardian. Full host access needed. ===
      {
        id: "sysadmin",
        workspace: "~/.openclaw/workspace-sysadmin",
        agentDir: "~/.openclaw/agents/sysadmin/agent",
        model: { primary: "openrouter/moonshotai/kimi-k2.5", fallbacks: ["openrouter/google/gemini-3-flash-preview"] },
        identity: { name: "Sysadmin", emoji: "🖥️" },
        groupChat: { mentionPatterns: ["@sysadmin", "@sys", "@Sysadmin"] },
        sandbox: { mode: "off" },
        heartbeat: { every: "30m", model: "openrouter/google/gemini-3-flash-preview" },
        tools: {
          // Sysadmin: full host access for infrastructure. No sessions_spawn.
          allow: ["exec", "read", "write", "edit", "sessions_list", "sessions_history", "sessions_send", "message", "memory_search", "memory_get", "gateway"],
          deny: ["browser", "web_search", "cron", "nodes", "canvas", "sessions_spawn"],
          agentToAgent: { enabled: true, allow: ["orchestrator"] },
        },
      },

      // === REVIEWER — Quality gate. Read-only by tool policy. ===
      {
        id: "reviewer",
        workspace: "~/.openclaw/workspace-reviewer",
        agentDir: "~/.openclaw/agents/reviewer/agent",
        model: { primary: "openrouter/google/gemini-3-flash-preview", fallbacks: ["openrouter/moonshotai/kimi-k2.5"] },
        identity: { name: "Reviewer", emoji: "🔍" },
        groupChat: { mentionPatterns: ["@reviewer", "@review", "@Reviewer"] },
        sandbox: { mode: "off" },
        heartbeat: { every: "4h", model: "openrouter/google/gemini-3-flash-preview" },
        tools: {
          // Reviewer: read-only. No exec, write, edit, apply_patch, or sessions_spawn.
          allow: ["read", "sessions_list", "sessions_history", "sessions_send", "message", "memory_search", "memory_get"],
          deny: ["exec", "write", "edit", "apply_patch", "browser", "web_search", "cron", "gateway", "nodes", "canvas", "sessions_spawn"],
          agentToAgent: { enabled: true, allow: ["orchestrator"] },
        },
      },
    ],
  },

  tools: {
    // Global ceiling — must include every tool any agent may use.
    // Per-agent tools.allow/deny narrows from here.
    allow: [
      "read", "write", "edit", "apply_patch",
      "exec", "process",
      "sessions_list", "sessions_history", "sessions_send", "sessions_spawn",
      "subagents", "session_status",
      "message",
      "web_search", "web_fetch",
      "browser",
      "memory_search", "memory_get",
      "cron", "gateway",
      "agents_list",
    ],
    // agentToAgent: hub-and-spoke routing enforced per-agent above (C-05)
    agentToAgent: {
      enabled: true,
    },
    elevated: { enabled: true, allowFrom: { discord: ["13362138764"] } },
    exec: { host: "gateway", security: "full", ask: "off", backgroundMs: 10000, timeoutSec: 1800 },
  },

  // Per-account bindings: each Discord bot account routes to its agent
  bindings: [
    { agentId: "orchestrator", match: { channel: "discord", accountId: "orchestrator" } },
    { agentId: "researcher", match: { channel: "discord", accountId: "researcher" } },
    { agentId: "developer", match: { channel: "discord", accountId: "developer" } },
    { agentId: "sysadmin", match: { channel: "discord", accountId: "sysadmin" } },
    { agentId: "reviewer", match: { channel: "discord", accountId: "reviewer" } },
    // Fallback: unmatched Discord traffic goes to orchestrator
    { agentId: "orchestrator", match: { channel: "discord" } },
  ],

  messages: { ackReaction: "👍", ackReactionScope: "all" },
  commands: { native: "auto", nativeSkills: "auto" },

  approvals: {
    exec: { enabled: true, mode: "targets", targets: [{ channel: "discord", to: "13362138764" }] },
  },

  session: {
    scope: "per-sender",
    resetTriggers: ["/new", "/reset", "/clear"],
    reset: { mode: "idle", idleMinutes: 60 },
    typingIntervalSeconds: 5,
  },

  channels: {
    discord: {
      enabled: true,
      allowBots: "mentions",
      groupPolicy: "allowlist",
      streaming: "off",
      execApprovals: {
        enabled: true,
        approvers: ["<DEVIN_DISCORD_USER_ID>"],
      },
      guilds: {
        "1472374974340665477": {
          requireMention: true,
          ignoreOtherMentions: true,
        },
      },
      accounts: {
        orchestrator: { token: "${DISCORD_ORCHESTRATOR_TOKEN}", groupPolicy: "allowlist", streaming: "off" },
        researcher: { token: "${DISCORD_RESEARCHER_TOKEN}", groupPolicy: "allowlist", streaming: "off" },
        developer: { token: "${DISCORD_DEVELOPER_TOKEN}", groupPolicy: "allowlist", streaming: "off" },
        sysadmin: { token: "${DISCORD_SYSADMIN_TOKEN}", groupPolicy: "allowlist", streaming: "off" },
        reviewer: { token: "${DISCORD_REVIEWER_TOKEN}", groupPolicy: "allowlist", streaming: "off" },
        default: { groupPolicy: "allowlist", dmPolicy: "pairing", allowFrom: ["13362138764"], streaming: "off" },
      },
      actions: {
        reactions: true, messages: true, threads: true, pins: true,
        search: true, memberInfo: true, roleInfo: true, channelInfo: true,
        channels: true, voiceStatus: true,
      },
    },
  },

  gateway: {
    port: 18789,
    mode: "local",
    bind: "lan",  // Container needs LAN binding; host-side port bound to 127.0.0.1
    openaiApi: { enabled: true },
    controlUi: {
      enabled: true,
      basePath: "/",
      allowedOrigins: ["http://127.0.0.1:18789", "http://100.113.138.27:18789"],
    },
    auth: { mode: "token", token: "${OPENCLAW_GATEWAY_TOKEN}" },
  },

  // Native features enabled (O-01, O-06, O-08, O-09)
  hooks: {
    enabled: true,
    webhooks: {
      "governance-alert": {
        url: "http://127.0.0.1:5678/webhook/openclaw-governance",
        events: ["cron.complete", "session.error", "heartbeat.alert"],
      },
    },
  },
  cron: {
    enabled: true,
    // Governance cron jobs — actual jobs added via `openclaw cron add` CLI.
    failureAlert: { enabled: true, after: 3, cooldownMs: 300000 },
  },

  plugins: {
    allow: ["discord", "cli-offload", "memory-core"],
    entries: {
      discord: { enabled: true },
      "cli-offload": { enabled: true },
    },
    slots: {
      memory: "memory-core",
    },
  },
}
